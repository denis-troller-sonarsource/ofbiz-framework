{
  "name": "ofbiz-api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Strangler-fig API Gateway fronting the OFBiz monolith. Phase 0, item 1: no-op reverse proxy.",
  "license": "Apache-2.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2",
    "http-proxy-middleware": "^2.0.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nock": "^13.5.5",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
